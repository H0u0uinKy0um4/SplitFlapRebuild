{
  "key": "dashboard",
  "name": "Dashboard",
  "icon": "📊",
  "description": "Date then weather",
  "category": "time",
  "default_delay": 4.0,
  "min_rows": 3,
  "min_cols": 11,
  "fields": [
    {
      "key": "clock_format",
      "label": "Clock format",
      "type": "select",
      "options": ["12h", "24h"],
      "default": "12h"
    },
    {
      "key": "weather_entity",
      "label": "Weather entity",
      "type": "entity",
      "domain": "weather",
      "placeholder": "weather.home",
      "help": "Preferred source. Uses Home Assistant's own weather data."
    },
    {
      "key": "zip_code",
      "label": "ZIP code (OpenWeather fallback)",
      "type": "text",
      "placeholder": "02118",
      "visible_when": {"key": "weather_entity", "equals": ""}
    },
    {
      "key": "weather_api_key",
      "label": "OpenWeather API key (fallback)",
      "type": "password",
      "placeholder": "optional",
      "visible_when": {"key": "weather_entity", "equals": ""}
    }
  ]
}
