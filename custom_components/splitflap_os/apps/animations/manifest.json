{
  "key": "animations",
  "name": "Animations",
  "icon": "🎨",
  "description": "Colour effects",
  "category": "animation",
  "default_delay": 0.4,
  "min_rows": 1,
  "min_cols": 1,
  "fields": [
    {
      "key": "anim_effect",
      "label": "Effect",
      "type": "select",
      "options": ["rainbow", "sweep", "checker", "twinkle"],
      "default": "rainbow"
    },
    {
      "key": "anim_style",
      "label": "Send order",
      "type": "select",
      "options": [
        "ltr",
        "rtl",
        "columns",
        "center_out",
        "outside_in",
        "diagonal",
        "random",
        "rain",
        "spiral"
      ],
      "default": "ltr"
    },
    {
      "key": "anim_speed",
      "label": "Frame delay (s)",
      "type": "number",
      "default": "0.4",
      "min": 0.1,
      "max": 5,
      "step": 0.1
    }
  ]
}
