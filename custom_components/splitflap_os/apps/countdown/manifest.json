{
  "key": "countdown",
  "name": "Countdown",
  "icon": "⏳",
  "description": "Timer to an event",
  "category": "time",
  "default_delay": 1.0,
  "min_rows": 3,
  "min_cols": 12,
  "fields": [
    {
      "key": "countdown_event",
      "label": "Event name",
      "type": "text",
      "placeholder": "NEW YEAR",
      "default": "NEW YEAR"
    },
    {
      "key": "countdown_target",
      "label": "Target date/time",
      "type": "datetime-local",
      "default": "2027-01-01T00:00:00",
      "help": "Local time in the configured timezone."
    },
    {
      "key": "clock_format",
      "label": "Clock format",
      "type": "select",
      "options": [
        "12h",
        "24h"
      ],
      "default": "12h"
    }
  ],
  "translations": {
    "cs": {
      "name": "Odpočítávání",
      "description": "Časovač do události",
      "fields": {
        "countdown_event": {
          "label": "Název události"
        },
        "countdown_target": {
          "label": "Cílové datum/čas",
          "help": "Místní čas v nakonfigurovaném časovém pásmu."
        },
        "clock_format": {
          "label": "Formát hodin",
          "options": {
            "12h": "12 h",
            "24h": "24 h"
          }
        }
      }
    },
    "en": {
      "fields": {
        "clock_format": {
          "options": {
            "12h": "12 h",
            "24h": "24 h"
          }
        }
      }
    }
  }
}
